# Kotoba – Caddy (automatic HTTPS). Replace the domain.
kotoba.example.com {
	root * /srv/kotoba
	encode gzip zstd
	@immutable path /assets/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@fresh path /index.html /sw.js /manifest.webmanifest /version.json
	header @fresh Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
